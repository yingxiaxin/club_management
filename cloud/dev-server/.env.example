# 可选：腾讯云 OCR。勿把真实密钥提交进仓库。
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_OCR_REGION=ap-guangzhou
# TENCENTCLOUD_OCR_ACTION=GeneralBasicOCR
# 高精度（更准、更贵）：GeneralAccurateOCR

# 可选：本地 RapidOCR 使用的 Python（默认自动探测 python / py）
# OCR_PYTHON=C:\Users\you\AppData\Local\Programs\Python\Python310\python.exe

# 强制仅用 Tesseract（跳过 RapidOCR）
# OCR_ENGINE=tesseract

# —— 云数据库（成员读写）——
# DATA_BACKEND=json 时仍用本地 data/members.json（默认）
# DATA_BACKEND=cloud 时走微信云开发 members 集合（需下方密钥）
# DATA_BACKEND=cloud
# CLOUDBASE_ENV=cloud1-d6gjqx2kd2f3765f4
# 密钥：云开发控制台 → 设置 → 环境设置 / 腾讯云 API 密钥（勿提交）
# CLOUDBASE_SECRET_ID=
# CLOUDBASE_SECRET_KEY=

# —— 扫码登录（P0-c）——
# 可选：云函数环境变量也可配同名项。逗号分隔的管理员 openid，首次确认时自动写入 users 为 super_admin
# ADMIN_OPENIDS=
# 小程序码版本：develop | trial | release（未正式发版用 develop）
# CLOUD_QR_ENV_VERSION=develop
# 本机出小程序码（推荐）：微信公众平台 → 开发设置 → AppSecret
# WECHAT_APPID=wx0a3fc7a2aee9f66f
# WECHAT_APP_SECRET=
# 若要坚持用云函数 openapi 出码（常遇 INVALID_WX_ACCESS_TOKEN）：云函数环境变量 ENABLE_CLOUD_WXACODE=1

# —— 应急账号（仅本机/服务器 .env；勿提交真实口令、勿写进页面）——
# EMERGENCY_SUPER_USERNAME=superadmin
# EMERGENCY_SUPER_PASSWORD=
# EMERGENCY_SUPER_DISPLAY_NAME=超管（应急）
# EMERGENCY_ADMIN_USERNAME=admin
# EMERGENCY_ADMIN_PASSWORD=
# EMERGENCY_ADMIN_DISPLAY_NAME=管理员（应急）

# —— 公网托管（方案甲 · 见 docs/管理端公网托管.md）——
# HOST=0.0.0.0
# PORT=3789
# SERVE_ADMIN=1
# ADMIN_DIST=../../admin/dist
# ADMIN_CORS_ORIGIN=https://admin.example.com
# CLOUD_QR_ENV_VERSION=release

