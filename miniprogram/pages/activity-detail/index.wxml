<view class="page">
  <view class="page-state" wx:if="{{loading}}">
    <text class="muted">加载中…</text>
  </view>
  <view class="page-state" wx:elif="{{error}}">
    <text class="danger">{{error}}</text>
    <button class="btn-primary retry" size="mini" bindtap="load">重试</button>
  </view>

  <view class="sheet" wx:elif="{{activity}}">
    <!-- 标题 + 提醒 -->
    <view class="block head">
      <view class="title-row">
        <text class="title {{activity.urgencyClass}}">{{activity.title}}</text>
        <view
          wx:if="{{activity.reminderCycle && activity.reminderCycle !== 'none'}}"
          class="remind-chip {{activity.myReminderSubscribed ? 'is-on' : ''}} {{!activity.canSubscribeReminder && !activity.myReminderSubscribed ? 'is-off' : ''}}"
          bindtap="onRemindMe"
        >
          <text wx:if="{{reminding}}">…</text>
          <text wx:elif="{{activity.myReminderSubscribed}}">已提醒</text>
          <text wx:elif="{{!activity.canSubscribeReminder}}">不可提醒</text>
          <text wx:else>提醒我</text>
        </view>
      </view>
      <view class="tags">
        <text class="tag {{activity.urgencyClass}}">
          <text wx:if="{{activity.urgencyIcon}}" class="tag-icon">{{activity.urgencyIcon}}</text>{{activity.typeLabel}}
        </text>
        <text class="tag muted-tag">{{activity.statusLabel}}</text>
      </view>
      <text class="remind-hint" wx:if="{{activity.reminderCycle && activity.reminderCycle !== 'none' && activity.reminderOffsetsText && !activity.myReminderSubscribed}}">
        开始前 {{activity.reminderOffsetsText}} 分钟推送
      </text>
      <text class="remind-hint" wx:elif="{{!activity.reminderCycle || activity.reminderCycle === 'none'}}">
        本活动未配置提醒
      </text>
    </view>

    <view class="divider"></view>

    <!-- 时间与说明 -->
    <view class="block">
      <view class="meta-line">
        <text class="meta-k">开始</text>
        <text class="meta-v">{{activity.startText}}</text>
      </view>
      <view class="meta-line" wx:if="{{activity.endText}}">
        <text class="meta-k">结束</text>
        <text class="meta-v">{{activity.endText}}</text>
      </view>
      <view class="meta-line col">
        <text class="meta-k">说明</text>
        <text class="meta-v wrap">{{activity.description || '无'}}</text>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 出席意向 -->
    <view class="block">
      <view class="sec-head">
        <text class="sec-title">出席意向</text>
        <text class="sec-meta" wx:if="{{activity.rsvpCounts}}">已表态 {{activity.rsvpCounts.total || 0}} 人</text>
      </view>

      <view class="rsvp-actions">
        <button
          wx:for="{{rsvpOptions}}"
          wx:key="status"
          class="rsvp-btn status-{{item.status}} {{activity.myRsvp === item.status ? 'is-active' : ''}} {{!activity.canChangeRsvp || submitting ? 'disabled' : ''}}"
          data-status="{{item.status}}"
          bindtap="onRsvp"
          disabled="{{!activity.canChangeRsvp || submitting}}"
        >{{item.label}}</button>
      </view>

      <text class="sec-hint" wx:if="{{!activity.canChangeRsvp}}">
        {{activity.rsvpLockedReason || '当前不可修改意向'}}
      </text>
      <text class="sec-hint" wx:elif="{{activity.myRsvp}}">可在活动开始前再次修改</text>
      <text class="sec-hint" wx:else>请选择：参加 / 待定 / 请假</text>

      <view class="rsvp-groups">
        <view class="rsvp-group">
          <view class="rsvp-group-head" data-key="going" bindtap="toggleGroup">
            <text class="rsvp-group-title going">参加 {{activity.rsvpCounts.going || 0}}</text>
            <text class="rsvp-chevron">{{expanded.going ? '▾' : '▸'}}</text>
          </view>
          <view class="rsvp-names" wx:if="{{expanded.going}}">
            <text class="muted" wx:if="{{!(activity.rsvpGroups.going && activity.rsvpGroups.going.length)}}">暂无</text>
            <text wx:for="{{activity.rsvpGroups.going}}" wx:key="memberId" class="rsvp-name">{{item.characterName}}</text>
          </view>
        </view>
        <view class="rsvp-group">
          <view class="rsvp-group-head" data-key="maybe" bindtap="toggleGroup">
            <text class="rsvp-group-title maybe">待定 {{activity.rsvpCounts.maybe || 0}}</text>
            <text class="rsvp-chevron">{{expanded.maybe ? '▾' : '▸'}}</text>
          </view>
          <view class="rsvp-names" wx:if="{{expanded.maybe}}">
            <text class="muted" wx:if="{{!(activity.rsvpGroups.maybe && activity.rsvpGroups.maybe.length)}}">暂无</text>
            <text wx:for="{{activity.rsvpGroups.maybe}}" wx:key="memberId" class="rsvp-name">{{item.characterName}}</text>
          </view>
        </view>
        <view class="rsvp-group">
          <view class="rsvp-group-head" data-key="decline" bindtap="toggleGroup">
            <text class="rsvp-group-title decline">请假 {{activity.rsvpCounts.decline || 0}}</text>
            <text class="rsvp-chevron">{{expanded.decline ? '▾' : '▸'}}</text>
          </view>
          <view class="rsvp-names" wx:if="{{expanded.decline}}">
            <text class="muted" wx:if="{{!(activity.rsvpGroups.decline && activity.rsvpGroups.decline.length)}}">暂无</text>
            <text wx:for="{{activity.rsvpGroups.decline}}" wx:key="memberId" class="rsvp-name">{{item.characterName}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 组队 -->
    <block wx:if="{{activity.enableTeam}}">
      <view class="divider"></view>
      <view class="block">
        <view class="sec-head">
          <text class="sec-title">组队</text>
          <text class="sec-meta">{{activity.teamCount || 0}} 支队伍</text>
        </view>
        <view class="team-row">
          <text class="sec-hint flex">查看本活动队伍，或直接创建</text>
          <view class="team-links">
            <text class="link" bindtap="goTeams">查看</text>
            <text class="link accent" bindtap="goCreateTeam">创建</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
