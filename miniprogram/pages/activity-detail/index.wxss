@import "../../styles/urgency.wxss";

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 64rpx;
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 70% 40% at 50% 0%, var(--color-bg-glow), transparent),
    var(--color-bg);
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.state {
  padding: 80rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.muted {
  color: var(--color-text-muted);
}

.danger {
  color: var(--color-danger);
  text-align: center;
}

.retry {
  width: auto !important;
  padding: 0 32rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.3;
}

.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-strong);
  color: var(--color-brand);
  background: var(--color-brand-muted);
}

.muted-tag {
  color: var(--color-text-secondary);
  border-color: var(--color-border);
  background: var(--color-surface);
}

.panel {
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  overflow: hidden;
}

.field {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.field:last-child {
  border-bottom: none;
}

.label {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.value {
  font-size: var(--font-size-md);
  color: var(--color-text);
  line-height: 1.5;
  word-break: break-all;
  white-space: pre-wrap;
}

.hint-panel {
  padding: 24rpx 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hint-panel.soft {
  background: transparent;
  border-style: dashed;
}

.hint-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-brand);
}

.hint-body {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.6;
}

.remind-btn {
  margin-top: 8rpx;
}

.hint-panel.reminder .rsvp-head {
  margin-bottom: 0;
}

.rsvp-panel {
  padding: 24rpx 28rpx 8rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rsvp-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.rsvp-total {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.rsvp-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.rsvp-btn {
  flex: 1;
  margin: 0 !important;
  padding: 0 8rpx !important;
  height: 72rpx;
  line-height: 72rpx;
  font-size: var(--font-size-md);
  border-radius: var(--radius-md) !important;
  background: var(--color-bg) !important;
  color: var(--color-text-secondary) !important;
  border: 1rpx solid var(--color-border) !important;
}

.rsvp-btn::after {
  border: none;
}

.rsvp-btn.is-active.status-going {
  color: var(--color-urgency-calm) !important;
  border-color: var(--color-urgency-calm-border) !important;
  background: var(--color-urgency-calm-muted) !important;
  font-weight: 600;
}

.rsvp-btn.is-active.status-maybe {
  color: var(--color-urgency-soon) !important;
  border-color: var(--color-urgency-soon-border) !important;
  background: var(--color-urgency-soon-muted) !important;
  font-weight: 600;
}

.rsvp-btn.is-active.status-decline {
  color: var(--color-urgency-hot) !important;
  border-color: var(--color-urgency-hot-border) !important;
  background: var(--color-urgency-hot-muted) !important;
  font-weight: 600;
}

.rsvp-btn.disabled {
  opacity: 0.55;
}

.rsvp-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.5;
}

.rsvp-groups {
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid var(--color-border);
  margin: 0 -28rpx;
}

.rsvp-group {
  border-bottom: 1rpx solid var(--color-border);
}

.rsvp-group:last-child {
  border-bottom: none;
}

.rsvp-group-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
}

.rsvp-group-title {
  font-size: var(--font-size-md);
  font-weight: 600;
}

.rsvp-group-title.going {
  color: var(--color-urgency-calm);
}

.rsvp-group-title.maybe {
  color: var(--color-urgency-soon);
}

.rsvp-group-title.decline {
  color: var(--color-urgency-hot);
}

.rsvp-chevron {
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
}

.rsvp-names {
  padding: 0 28rpx 20rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
}

.rsvp-name {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
}
