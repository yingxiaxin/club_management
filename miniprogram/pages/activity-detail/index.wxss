@import "../../styles/shell.wxss";
@import "../../styles/urgency.wxss";
@import "../../styles/pathway.wxss";

.page {
  padding-bottom: 64rpx;
}

.sheet {
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-strong);
  background:
    linear-gradient(165deg, rgba(135, 116, 80, 0.07), transparent 38%),
    var(--color-surface);
  overflow: hidden;
}

.block {
  padding: 28rpx 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.block.head {
  gap: 14rpx;
}

.divider {
  height: 1rpx;
  margin: 0 28rpx;
  background: var(--color-border);
}

.title-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.title {
  flex: 1;
  min-width: 0;
  font-size: 42rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.3;
}

.remind-chip {
  flex-shrink: 0;
  margin-top: 6rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border-strong);
  color: var(--color-brand);
  background: var(--color-brand-muted);
}

.remind-chip.is-on {
  color: var(--color-urgency-calm);
  border-color: var(--color-urgency-calm-border);
  background: var(--color-urgency-calm-muted);
}

.remind-chip.is-off {
  opacity: 0.55;
  color: var(--color-text-muted);
  border-color: var(--color-border);
  background: var(--color-bg);
}

.remind-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.4;
}

.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-strong);
  color: var(--color-brand);
  background: var(--color-brand-muted);
}

.muted-tag {
  color: var(--color-text-secondary);
  border-color: var(--color-border);
  background: var(--color-bg);
}

.meta-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 20rpx;
}

.meta-line.col {
  flex-direction: column;
  gap: 8rpx;
}

.meta-k {
  flex-shrink: 0;
  width: 64rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.meta-line.col .meta-k {
  width: auto;
}

.meta-v {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-md);
  color: var(--color-text);
  line-height: 1.45;
}

.meta-v.wrap {
  white-space: pre-wrap;
  word-break: break-all;
}

.sec-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.sec-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-brand);
  letter-spacing: 0.04em;
}

.sec-meta {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.sec-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.5;
}

.sec-hint.flex {
  flex: 1;
  min-width: 0;
}

.rsvp-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.rsvp-btn {
  flex: 1;
  margin: 0 !important;
  padding: 0 8rpx !important;
  height: 72rpx;
  line-height: 72rpx;
  font-size: var(--font-size-md);
  border-radius: var(--radius-md) !important;
  background: var(--color-bg) !important;
  color: var(--color-text-secondary) !important;
  border: 1rpx solid var(--color-border) !important;
}

.rsvp-btn::after {
  border: none;
}

.rsvp-btn.is-active.status-going {
  color: var(--color-urgency-calm) !important;
  border-color: var(--color-urgency-calm-border) !important;
  background: var(--color-urgency-calm-muted) !important;
  font-weight: 600;
}

.rsvp-btn.is-active.status-maybe {
  color: var(--color-urgency-soon) !important;
  border-color: var(--color-urgency-soon-border) !important;
  background: var(--color-urgency-soon-muted) !important;
  font-weight: 600;
}

.rsvp-btn.is-active.status-decline {
  color: var(--color-urgency-hot) !important;
  border-color: var(--color-urgency-hot-border) !important;
  background: var(--color-urgency-hot-muted) !important;
  font-weight: 600;
}

.rsvp-btn.disabled {
  opacity: 0.55;
}

.rsvp-groups {
  display: flex;
  flex-direction: column;
  margin-top: 4rpx;
}

.rsvp-group-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.rsvp-group-title {
  font-size: var(--font-size-md);
  font-weight: 600;
}

.rsvp-group-title.going {
  color: var(--color-urgency-calm);
}

.rsvp-group-title.maybe {
  color: var(--color-urgency-soon);
}

.rsvp-group-title.decline {
  color: var(--color-urgency-hot);
}

.rsvp-chevron {
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
}

.rsvp-names {
  padding: 0 0 12rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
}

.rsvp-name {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
}

.team-block:active {
  background: var(--color-brand-muted);
}

.team-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.link.accent {
  flex-shrink: 0;
  font-size: var(--font-size-md);
  color: var(--color-brand);
  font-weight: 600;
  padding: 4rpx 0;
}
