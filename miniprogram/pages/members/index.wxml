<view class="page">
  <view class="toolbar panel-card">
    <input
      class="search"
      value="{{q}}"
      placeholder="搜索角色名 / 途径 / 备注"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearch"
    />
    <view class="sorts">
      <text
        class="chip {{sort === 'powerScore' ? 'active' : ''}}"
        data-sort="powerScore"
        bindtap="onSort"
      >评分</text>
      <text
        class="chip {{sort === 'fashionScore' ? 'active' : ''}}"
        data-sort="fashionScore"
        bindtap="onSort"
      >风尚</text>
      <text
        class="chip {{sort === 'joinedAt' ? 'active' : ''}}"
        data-sort="joinedAt"
        bindtap="onSort"
      >入会</text>
      <text class="chip order" bindtap="onToggleOrder">{{order === 'desc' ? '↓' : '↑'}}</text>
    </view>
    <scroll-view wx:if="{{pathwayOptions.length}}" class="filters" scroll-x>
      <text
        class="chip {{!pathway ? 'active' : ''}}"
        data-pathway=""
        bindtap="onPathway"
      >全部途径</text>
      <text
        wx:for="{{pathwayOptions}}"
        wx:key="*this"
        class="chip {{pathway === item ? 'active' : ''}}"
        data-pathway="{{item}}"
        bindtap="onPathway"
      >{{item}}</text>
    </scroll-view>
    <scroll-view wx:if="{{titleOptions.length}}" class="filters" scroll-x>
      <text
        class="chip {{!title ? 'active' : ''}}"
        data-title=""
        bindtap="onTitle"
      >全部职位</text>
      <text
        wx:for="{{titleOptions}}"
        wx:key="*this"
        class="chip {{title === item ? 'active' : ''}}"
        data-title="{{item}}"
        bindtap="onTitle"
      >{{item}}</text>
    </scroll-view>
  </view>

  <view class="page-state" wx:if="{{loading}}">
    <text class="muted">加载中…</text>
  </view>
  <view class="page-state" wx:elif="{{error}}">
    <text class="danger">{{error}}</text>
    <button class="btn-primary retry" size="mini" bindtap="load">重试</button>
  </view>
  <view class="empty-panel" wx:elif="{{!list.length}}">
    <text class="muted">没有符合条件的成员</text>
    <text class="muted tiny">可清空搜索或筛选后再试</text>
  </view>

  <view class="list-stack" wx:else>
    <view
      class="bar-row {{item.pathwayTint}}"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="bar accent" />
      <view class="bar-main">
        <view class="row-top">
          <text class="name">{{item.characterName}}</text>
          <text class="chip-tag">{{item.title}}</text>
        </view>
        <view class="row-sub">
          <text class="pathway">{{item.pathway}}</text>
          <text class="lv" wx:if="{{item.level}}">Lv.{{item.level}}</text>
        </view>
        <view class="scores">
          <view class="score">
            <text class="score-label">非凡</text>
            <text class="score-num">{{item.powerScore}}</text>
          </view>
          <view class="score">
            <text class="score-label">风尚</text>
            <text class="score-num secondary">{{item.fashionScore}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
