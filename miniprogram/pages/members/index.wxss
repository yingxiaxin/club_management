.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: var(--color-bg);
}

.toolbar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
  position: sticky;
  top: 0;
  z-index: 2;
  padding-bottom: 8rpx;
  background: var(--color-bg);
}

.search {
  padding: 18rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: var(--font-size-md);
}

.sorts,
.filters {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  background: var(--color-surface);
}

.chip.active {
  color: var(--color-brand);
  border-color: var(--color-border-strong);
  background: var(--color-brand-muted);
}

.chip.order {
  min-width: 56rpx;
  text-align: center;
}

.state {
  padding: 80rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.muted {
  color: var(--color-text-muted);
}

.danger {
  color: var(--color-danger);
  text-align: center;
}

.retry {
  width: auto !important;
  padding: 0 32rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.row {
  padding: 24rpx 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.row:active {
  background: var(--color-brand-muted);
  border-color: var(--color-border-strong);
}

.row-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.name {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-strong);
  color: var(--color-brand);
}

.row-sub {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.scores {
  display: flex;
  flex-direction: row;
  gap: 32rpx;
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.score {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
}

.score-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.score-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.score-num.secondary {
  color: var(--color-text-secondary);
  font-weight: 600;
}
