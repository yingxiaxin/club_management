@import "../../styles/shell.wxss";

.page {
  padding-bottom: 32rpx;
  gap: 20rpx;
}

.toolbar {
  padding: 20rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  position: sticky;
  top: 0;
  z-index: 2;
}

.search {
  padding: 16rpx 22rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface-elevated);
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: var(--font-size-md);
}

.sorts,
.filters {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  background: var(--color-bg);
}

.chip.active {
  color: var(--color-brand);
  border-color: var(--color-border-strong);
  background: var(--color-brand-muted);
}

.chip.order {
  min-width: 56rpx;
  text-align: center;
}

.row-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.name {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text);
}

.row-sub {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.scores {
  display: flex;
  flex-direction: row;
  gap: 28rpx;
  margin-top: 4rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border);
}

.score {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
}

.score-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.score-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.score-num.secondary {
  color: var(--color-text-secondary);
  font-weight: 600;
}
