<view class="page">
  <view class="page-state" wx:if="{{loading}}">
    <text class="muted">加载中…</text>
  </view>
  <view class="page-state" wx:elif="{{error}}">
    <text class="danger">{{error}}</text>
    <button class="btn-primary retry" size="mini" bindtap="load">重试</button>
  </view>

  <view class="panel" wx:elif="{{album}}">
    <view class="head-row">
      <view class="head-text">
        <text class="work-title">{{album.title}}</text>
        <text class="author text-pathway {{album.pathwayTint}}">{{album.characterName || '成员'}}</text>
        <text class="muted tiny" wx:if="{{album.createdAtLabel}}">{{album.createdAtLabel}}</text>
      </view>
      <view class="head-actions">
        <view
          wx:if="{{canLike}}"
          class="icon-action {{liking ? 'disabled' : ''}} {{album.likedByMe ? 'liked' : ''}}"
          bindtap="onToggleLike"
          hover-class="icon-action-hover"
          hover-stay-time="80"
        >
          <text class="icon-action-mark">{{album.likedByMe ? '♥' : '♡'}}</text>
          <text class="icon-action-label">{{album.likeCount || 0}}</text>
        </view>
        <view
          wx:if="{{canDelete}}"
          class="icon-action {{withdrawing ? 'disabled' : ''}}"
          bindtap="onWithdraw"
          hover-class="icon-action-hover"
          hover-stay-time="80"
        >
          <text class="icon-action-mark">↶</text>
          <text class="icon-action-label">撤回作品</text>
        </view>
      </view>
    </view>

    <view class="images">
      <view class="img-cell" wx:for="{{album.images}}" wx:key="id">
        <image
          class="flat-img"
          src="{{item.imageFileId}}"
          mode="aspectFill"
          data-url="{{item.imageFileId}}"
          bindtap="onPreview"
          show-menu-by-longpress
        />
        <view
          wx:if="{{canDelete}}"
          class="img-remove {{removingId === item.id ? 'disabled' : ''}}"
          data-id="{{item.id}}"
          catchtap="onRemoveImage"
          hover-class="img-remove-hover"
          hover-stay-time="80"
        >
          <text class="img-remove-mark">✕</text>
        </view>
      </view>

      <view
        wx:if="{{canAppend}}"
        class="img-cell add {{appending ? 'disabled' : ''}}"
        bindtap="onAppend"
        hover-class="img-add-hover"
        hover-stay-time="80"
      >
        <text class="add-plus">+</text>
        <text class="add-hint">继续上传</text>
        <text class="add-count">{{album.images.length}}/9</text>
      </view>
    </view>
  </view>
</view>

<home-fab />
