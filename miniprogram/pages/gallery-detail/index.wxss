@import "../../styles/shell.wxss";

.panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.head-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
}

.head-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.work-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-brand);
  line-height: 1.4;
}

.author {
  font-size: var(--font-size-sm);
  color: var(--color-text);
  line-height: 1.4;
}

.tiny {
  font-size: 22rpx;
}

.head-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 10rpx;
}

.icon-action {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 88rpx;
  padding: 14rpx 14rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface-elevated);
  box-sizing: border-box;
}

.icon-action.liked .icon-action-mark {
  color: var(--color-brand);
}

.icon-action-hover {
  background: var(--color-brand-muted);
  border-color: var(--color-border-strong);
}

.icon-action.disabled {
  opacity: 0.55;
  pointer-events: none;
}

.icon-action-mark {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 44rpx;
  text-align: center;
  color: var(--color-brand);
}

.icon-action-label {
  font-size: 20rpx;
  color: var(--color-text-muted);
  line-height: 1.2;
}

.images {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-cell {
  position: relative;
  width: calc((100% - 16rpx) / 2);
  height: 280rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface-elevated);
  overflow: hidden;
  box-sizing: border-box;
}

.flat-img {
  width: 100%;
  height: 100%;
  display: block;
}

.img-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 3;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1rpx solid var(--color-border-strong);
  background: rgba(0, 0, 0, 0.62);
  box-sizing: border-box;
}

.img-remove-hover {
  background: rgba(0, 0, 0, 0.82);
}

.img-remove.disabled {
  opacity: 0.55;
  pointer-events: none;
}

.img-remove-mark {
  font-size: 22rpx;
  line-height: 1;
  color: var(--color-brand);
  font-weight: 600;
}

.img-cell.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-style: dashed;
  border-color: var(--color-border-strong);
  background: var(--color-surface);
}

.img-add-hover {
  background: var(--color-brand-muted);
}

.img-cell.add.disabled {
  opacity: 0.55;
  pointer-events: none;
}

.add-plus {
  font-size: 48rpx;
  line-height: 1;
  color: var(--color-brand);
}

.add-hint {
  font-size: 22rpx;
  color: var(--color-text);
}

.add-count {
  font-size: 20rpx;
  color: var(--color-text-muted);
}
