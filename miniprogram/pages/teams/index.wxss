@import "../../styles/shell.wxss";

.section-head {
  align-items: center;
}

.filter-panel {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.filter-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  height: auto;
  line-height: 1.2;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  background: var(--color-bg);
  box-sizing: border-box;
}

.chip.active {
  color: var(--color-brand);
  border-color: var(--color-border-strong);
  background: var(--color-brand-muted);
}

.head-left {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.create-link {
  flex-shrink: 0;
  font-size: var(--font-size-md);
  color: var(--color-brand);
  font-weight: 600;
  padding: 4rpx 0;
}

.bar-row.is-mine {
  border-color: var(--color-border-strong);
  background:
    linear-gradient(90deg, rgba(189, 163, 119, 0.08), transparent 48%),
    var(--color-surface);
}

.row-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.row-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.4;
}

.badge {
  align-self: flex-start;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-brand);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-strong);
  background: var(--color-brand-muted);
}

.empty-panel .create-link {
  margin-top: 8rpx;
}
