@import "../../styles/shell.wxss";

.panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 36rpx 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-strong);
  background:
    linear-gradient(165deg, rgba(189, 163, 119, 0.1), transparent 45%),
    var(--color-surface);
}

.title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-brand);
  letter-spacing: 0.04em;
}

.meta,
.label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.pick-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pick-cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  height: 200rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface-elevated);
  overflow: hidden;
  box-sizing: border-box;
}

.pick-cell.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-style: dashed;
  border-color: var(--color-border-strong);
}

.pick-cell.add:active {
  background: var(--color-brand-muted);
}

.pick-img {
  width: 100%;
  height: 100%;
  display: block;
}

.pick-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.preview-plus {
  font-size: 48rpx;
  line-height: 1;
  color: var(--color-brand);
}

.tiny {
  font-size: 20rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.textarea {
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface-elevated);
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: var(--font-size-md);
  box-sizing: border-box;
  width: 100%;
}

.msg {
  font-size: var(--font-size-sm);
  color: var(--color-brand);
  line-height: 1.5;
}
