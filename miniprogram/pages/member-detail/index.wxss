@import "../../styles/shell.wxss";

.page {
  padding-bottom: 64rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx 28rpx;
}

.name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-brand);
  letter-spacing: 0.06em;
}

.tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-strong);
  color: var(--color-brand);
  background: var(--color-brand-muted);
}

.muted-tag {
  color: var(--color-text-secondary);
  border-color: var(--color-border);
  background: var(--color-bg);
}

.scores {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.score-card {
  flex: 1;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.score-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.score-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-brand);
}

.score-num.alt {
  color: var(--color-text-secondary);
}

.panel {
  overflow: hidden;
}

.field {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.field:last-child {
  border-bottom: none;
}

.label {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.value {
  font-size: var(--font-size-md);
  color: var(--color-text);
  line-height: 1.5;
  word-break: break-all;
}
