<view class="page">
  <view class="hero">
    <text class="brand">诡秘之主</text>
    <text class="subtitle">俱乐部成员端</text>
  </view>

  <view class="panel" wx:if="{{loading}}">
    <text class="muted">正在识别微信身份…</text>
  </view>

  <view class="panel" wx:elif="{{error}}">
    <text class="danger">{{error}}</text>
    <button class="btn-primary" bindtap="refresh">重试</button>
  </view>

  <block wx:else>
    <view class="panel status">
      <text class="label">当前身份</text>
      <text class="value">{{roleLabel}}</text>
      <text class="meta" wx:if="{{displayName}}">{{displayName}}</text>
      <text class="muted" wx:elif="{{joinPending}}">关联申请审核中</text>
      <text class="muted" wx:else>尚未关联游戏角色</text>
    </view>

    <view class="panel schedule" wx:if="{{canViewMembers}}">
      <view class="schedule-head">
        <text class="schedule-title">今日活动</text>
        <text class="schedule-link" bindtap="goActivities">全部日程</text>
      </view>
      <view wx:if="{{scheduleLoading}}">
        <text class="muted">加载日程…</text>
      </view>
      <view class="schedule-empty" wx:elif="{{!todayPreview.length}}">
        <text class="muted">今日暂无活动</text>
        <text class="muted tiny" wx:if="{{weekCount}}">本周还有 {{weekCount}} 场 · 点「全部日程」查看</text>
      </view>
      <view class="schedule-list" wx:else>
        <view
          class="schedule-row"
          wx:for="{{todayPreview}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goActivityDetail"
        >
          <view class="schedule-main">
            <text class="schedule-name {{item.urgencyClass}}">{{item.title}}</text>
            <text wx:if="{{item.typeLabel}}" class="tag {{item.urgencyClass}}">
              <text wx:if="{{item.urgencyIcon}}" class="tag-icon">{{item.urgencyIcon}}</text>{{item.typeLabel}}
            </text>
          </view>
          <text class="schedule-time">{{item.startText}}</text>
        </view>
        <text class="muted tiny" wx:if="{{todayCount > todayPreview.length}}">
          今日共 {{todayCount}} 场
        </text>
      </view>
    </view>

    <view class="actions">
      <button
        wx:if="{{canViewMembers}}"
        class="btn-primary"
        bindtap="goActivities"
      >
        活动日程
      </button>
      <button
        wx:if="{{canViewMembers}}"
        class="btn-ghost"
        bindtap="goMembers"
      >
        查看成员列表
      </button>
      <button
        wx:else
        class="btn-primary"
        bindtap="goJoin"
      >
        邀请码关联角色
      </button>
      <button
        wx:if="{{isAdmin && !memberId}}"
        class="btn-ghost"
        bindtap="goJoin"
      >
        邀请码关联（联调）
      </button>
      <button
        wx:if="{{isAdmin && memberId}}"
        class="btn-ghost"
        bindtap="goJoin"
      >
        关联页 / 解除联调绑定
      </button>
      <button class="btn-ghost" bindtap="goAdminLogin">管理端扫码登录</button>
    </view>

    <text class="hint">
      成员名单由管理员维护。需邀请码且角色名与名单一致才能关联微信；未关联前不可查看俱乐部成员信息与活动细节。
    </text>
  </block>
</view>
