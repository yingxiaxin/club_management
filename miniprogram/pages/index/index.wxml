<view class="page">
  <!-- 品牌门厅 -->
  <view class="hero">
    <view class="hero-glow" />
    <view class="hero-frame">
      <view class="hero-inner">
        <image
          wx:if="{{clubIconUrl}}"
          class="club-icon"
          src="{{clubIconUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="club-icon placeholder">
          <text class="placeholder-mark">会</text>
        </view>
        <view class="brand-text">
          <text class="brand">{{clubName}}</text>
          <text class="intro" wx:if="{{clubIntro}}">{{clubIntro}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="panel state" wx:if="{{loading}}">
    <text class="muted">正在识别微信身份…</text>
  </view>

  <view class="panel state" wx:elif="{{error}}">
    <text class="danger">{{error}}</text>
    <button class="btn-primary btn-inline" bindtap="refresh">重试</button>
  </view>

  <block wx:else>
    <!-- 会务条：身份 + 日程（紧跟）；解绑靠右；成员走底 Tab -->
    <view class="hub">
      <view class="hub-row">
        <view class="hub-identity">
          <view class="identity-dot {{canViewMembers ? 'ok' : 'wait'}}" />
          <text class="hub-role">{{roleLabel}}</text>
          <text class="hub-name {{identityPathwayTint}}">{{identityLine}}</text>
        </view>
        <view class="hub-schedule" wx:if="{{canViewMembers}}" bindtap="goActivities">
          <text class="hub-schedule-text">日程 · 今日 {{todayCount}} · 本周 {{weekCount}}</text>
          <text class="hub-schedule-arrow">›</text>
        </view>
        <view
          wx:if="{{isAdmin && memberId}}"
          class="hub-unbind"
          catchtap="onUnbindTap"
        >
          <text class="hub-unbind-mark">⊘</text>
          <text class="hub-unbind-label">解绑</text>
        </view>
      </view>
    </view>

    <!-- 访客：待审 / 引导关联（未关联时；与 hub 并列） -->
    <view class="guest-cta" wx:if="{{!canViewMembers && joinPending}}">
      <text class="guest-title">关联申请审核中</text>
      <text class="hint">管理员确认后，即可查看公告、活动与成员。也可点下方查看申请详情。</text>
      <button class="btn-primary" bindtap="goJoin">查看申请状态</button>
      <button class="btn-ghost" bindtap="refresh">刷新</button>
    </view>
    <view class="guest-cta" wx:elif="{{!canViewMembers}}">
      <text class="guest-title">加入俱乐部</text>
      <text class="hint">名单由管理员维护。请按下面三步关联你的游戏角色：</text>
      <view class="steps">
        <text class="step">1. 向管理员索取邀请码</text>
        <text class="step">2. 填写与名单完全一致的角色名</text>
        <text class="step">3. 提交后等待管理员确认</text>
      </view>
      <button class="btn-primary" bindtap="goJoin">邀请码关联角色</button>
    </view>

    <!-- 公告：轮播；查看更多进全部列表 -->
    <view class="section" wx:if="{{canViewMembers}}">
      <view class="section-head">
        <view class="section-title-row">
          <text class="section-title">公告</text>
          <text class="section-desc">俱乐部重要事项通知</text>
        </view>
        <text
          class="section-link"
          wx:if="{{announcements.length}}"
          bindtap="goAnnouncements"
        >查看更多</text>
      </view>
      <view class="panel soft" wx:if="{{announceLoading}}">
        <text class="muted">加载公告…</text>
      </view>
      <view class="panel soft empty" wx:elif="{{!announcements.length}}">
        <text class="muted">暂无公告</text>
        <text class="muted tiny">有新通知时会出现在这里</text>
      </view>
      <view class="announce-swiper-wrap" wx:else>
        <swiper
          class="announce-swiper"
          autoplay="{{announcements.length > 1}}"
          circular="{{announcements.length > 1}}"
          interval="4500"
          duration="480"
          indicator-dots="{{announcements.length > 1}}"
          indicator-color="rgba(154, 140, 120, 0.35)"
          indicator-active-color="#bda377"
          bindchange="onAnnounceSwiperChange"
        >
          <swiper-item wx:for="{{announcements}}" wx:key="id">
            <view
              class="announce-card {{item.pinned ? 'pinned' : ''}}"
              data-id="{{item.id}}"
              bindtap="goAnnounceDetail"
            >
              <view class="announce-accent" />
              <view class="announce-body">
                <view class="announce-head">
                  <text class="announce-title">{{item.title}}</text>
                  <text wx:if="{{item.pinned}}" class="pin">置顶</text>
                  <text class="announce-date" wx:if="{{item.publishedText}}">{{item.publishedText}}</text>
                </view>
                <text class="announce-content">{{item.content}}</text>
              </view>
            </view>
          </swiper-item>
        </swiper>
      </view>
    </view>

    <!-- 踏云寻芳 -->
    <view class="section" wx:if="{{canViewMembers}}">
      <view class="section-head">
        <view class="section-title-row">
          <text class="section-title">踏云寻芳</text>
          <text class="section-desc">循着团友们的足迹探索世界</text>
        </view>
        <text class="section-link" bindtap="goGallery">查看更多</text>
      </view>
      <view class="panel soft" wx:if="{{galleryLoading}}">
        <text class="muted">加载作品…</text>
      </view>
      <view class="panel soft empty" wx:elif="{{!galleryPages.length}}">
        <text class="muted">暂无作品</text>
        <text class="muted tiny">成员可分享风景与自拍</text>
      </view>
      <view class="gallery-swiper-wrap" wx:else>
        <swiper
          class="gallery-swiper"
          autoplay="{{galleryPages.length > 1}}"
          circular="{{galleryPages.length > 1}}"
          interval="5000"
          duration="480"
          indicator-dots="{{galleryPages.length > 1}}"
          indicator-color="rgba(154, 140, 120, 0.35)"
          indicator-active-color="#bda377"
        >
          <swiper-item wx:for="{{galleryPages}}" wx:key="key">
            <view class="gallery-page">
              <view
                class="gallery-chip"
                wx:for="{{item.items}}"
                wx:for-item="work"
                wx:key="albumId"
                data-id="{{work.albumId || work.id}}"
                bindtap="goGalleryDetail"
              >
                <view class="photo-stack compact">
                  <view class="photo-stack-layer back2" />
                  <view class="photo-stack-layer back1" />
                  <image
                    class="photo-stack-front"
                    src="{{work.thumbFileId || work.imageFileId}}"
                    mode="aspectFill"
                    lazy-load
                  />
                </view>
                <view class="gallery-chip-meta">
                  <text class="gallery-chip-title">{{work.caption || '未命名作品'}}</text>
                  <view class="gallery-chip-foot">
                    <text class="gallery-chip-name">{{work.characterName || '成员'}}</text>
                    <text class="gallery-chip-likes">♡ {{work.likeCount || 0}}</text>
                  </view>
                </view>
              </view>
            </view>
          </swiper-item>
        </swiper>
      </view>
    </view>

    <!-- 今日活动 -->
    <view class="section" wx:if="{{canViewMembers}}">
      <view class="section-head">
        <view class="section-title-row">
          <text class="section-title">今日活动</text>
          <text class="section-desc">团队需要你</text>
        </view>
        <text class="section-link" bindtap="goActivities">全部日程</text>
      </view>
      <view class="panel soft" wx:if="{{scheduleLoading}}">
        <text class="muted">加载日程…</text>
      </view>
      <view class="panel soft empty" wx:elif="{{!todayPreview.length}}">
        <text class="muted">今日暂无活动</text>
        <text class="muted tiny" wx:if="{{weekCount}}">本周还有 {{weekCount}} 场，可点「全部日程」查看</text>
        <text class="muted tiny" wx:else>有新活动时会出现在这里</text>
      </view>
      <view class="event-list" wx:else>
        <view
          class="event-row"
          wx:for="{{todayPreview}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goActivityDetail"
        >
          <view class="event-bar {{item.urgencyClass}}" />
          <view class="event-main">
            <view class="event-top">
              <text class="event-name {{item.urgencyClass}}">{{item.title}}</text>
              <text wx:if="{{item.typeLabel}}" class="tag {{item.urgencyClass}}">
                <text wx:if="{{item.urgencyIcon}}" class="tag-icon">{{item.urgencyIcon}}</text>{{item.typeLabel}}
              </text>
            </view>
            <view class="event-meta">
              <text class="event-time">{{item.startText}}</text>
              <text class="event-phase phase-{{item.occurrencePhase}}">{{item.occurrencePhaseLabel}}</text>
            </view>
          </view>
        </view>
        <text class="muted tiny more" wx:if="{{todayCount > todayPreview.length}}">
          今日共 {{todayCount}} 场 · 点「全部日程」查看
        </text>
      </view>
    </view>

  </block>
</view>
