@import "../../styles/urgency.wxss";

.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 80% 50% at 50% -10%, var(--color-bg-glow), transparent),
    var(--color-bg);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 0 8rpx;
}

.brand-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.club-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-strong);
  background: var(--color-surface);
  flex-shrink: 0;
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.brand {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--color-brand);
}

.subtitle {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.panel {
  padding: 32rpx 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.status .label {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.status .value {
  font-size: var(--font-size-lg);
  color: var(--color-text);
  font-weight: 600;
}

.status .meta {
  font-size: var(--font-size-md);
  color: var(--color-brand);
}

.muted {
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.danger {
  color: var(--color-danger);
  font-size: var(--font-size-md);
  margin-bottom: 16rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.6;
}

.schedule-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.schedule-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text);
}

.schedule-link {
  font-size: var(--font-size-sm);
  color: var(--color-brand);
}

.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.schedule-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.schedule-row:last-child {
  border-bottom: none;
}

.schedule-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.schedule-name {
  font-size: var(--font-size-md);
  color: var(--color-text);
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-strong);
  color: var(--color-brand);
  background: var(--color-brand-muted);
}

.schedule-time {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.schedule-empty {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 4rpx;
}

.tiny {
  font-size: 22rpx;
}

.announce-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}

.announce-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.announce-row:last-child {
  border-bottom: none;
}

.announce-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.announce-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text);
}

.pin {
  font-size: 20rpx;
  color: var(--color-brand);
  border: 1rpx solid var(--color-brand);
  border-radius: var(--radius-sm);
  padding: 2rpx 10rpx;
}

.announce-body {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.announce-body.open {
  -webkit-line-clamp: unset;
  display: block;
  color: var(--color-text);
}
