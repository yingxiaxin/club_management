@import "../../styles/urgency.wxss";
@import "../../styles/pathway.wxss";

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 90% 45% at 50% -8%, var(--color-bg-glow), transparent 70%),
    var(--color-bg);
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* —— 品牌门厅 —— */
.hero {
  position: relative;
  padding: 12rpx 0 8rpx;
}

.hero-glow {
  position: absolute;
  left: 10%;
  right: 10%;
  top: 20%;
  height: 120rpx;
  background: radial-gradient(ellipse at center, var(--color-brand-glow), transparent 72%);
  opacity: 0.45;
  pointer-events: none;
}

.hero-frame {
  position: relative;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-strong);
  background:
    linear-gradient(165deg, rgba(189, 163, 119, 0.08), transparent 42%),
    var(--color-surface);
  box-shadow: 0 0 40rpx rgba(189, 163, 119, 0.08);
  overflow: hidden;
}

.hero-frame::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: linear-gradient(180deg, var(--color-brand-hover), var(--color-brand), transparent);
}

.hero-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
  padding: 36rpx 32rpx;
}

.club-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border-strong);
  background: var(--color-surface-elevated);
  flex-shrink: 0;
  box-shadow: 0 0 24rpx rgba(189, 163, 119, 0.18);
}

.club-icon.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-mark {
  font-size: 44rpx;
  color: var(--color-brand);
  font-weight: 700;
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.brand {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--color-brand);
  line-height: 1.25;
}

.intro {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

/* —— 会务条：身份 + 日程（成员走底 Tab） —— */
.hub {
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background:
    linear-gradient(180deg, rgba(189, 163, 119, 0.07), transparent 70%),
    var(--color-surface-glass);
  overflow: hidden;
  box-shadow: inset 0 1rpx 0 rgba(189, 163, 119, 0.06);
}

.hub-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 18rpx;
  min-height: 72rpx;
  box-sizing: border-box;
}

.hub-identity {
  /* 不占满剩余宽度，日程才能紧跟角色名 */
  flex: 0 1 auto;
  max-width: 42%;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
}

.hub-role {
  font-size: 20rpx;
  color: var(--color-brand);
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  padding: 2rpx 10rpx;
  background: var(--color-brand-muted);
  flex-shrink: 0;
  line-height: 1.3;
}

.hub-name {
  flex: 1 1 0;
  min-width: 0;
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.identity-dot.ok {
  background: var(--color-success);
  box-shadow: 0 0 8rpx var(--color-success);
}

.identity-dot.wait {
  background: var(--color-warning);
  box-shadow: 0 0 8rpx var(--color-warning);
}

.hub-schedule {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  gap: 2rpx;
  max-width: 300rpx;
  height: 52rpx;
  padding: 0 10rpx 0 12rpx;
  box-sizing: border-box;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.hub-schedule:active {
  background: var(--color-brand-muted);
  border-color: var(--color-border-strong);
}

.hub-schedule-text {
  font-size: 22rpx;
  line-height: 52rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hub-schedule-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  font-size: 22rpx;
  line-height: 52rpx;
  color: var(--color-brand);
  flex-shrink: 0;
  /* › 字形偏下，微上移与文字视觉居中 */
  transform: translateY(-1rpx);
}

.hub-unbind {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  margin-left: auto;
  min-width: 64rpx;
  padding: 6rpx 8rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  flex-shrink: 0;
}

.hub-unbind:active {
  background: var(--color-brand-muted);
  border-color: var(--color-border-strong);
}

.hub-unbind-mark {
  font-size: 26rpx;
  line-height: 1;
  color: var(--color-text-muted);
}

.hub-unbind-label {
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--color-text-muted);
}

.guest-cta {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.guest-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: 0.04em;
}

.steps {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 4rpx 0 8rpx;
}

.step {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary, var(--color-text-muted));
  line-height: 1.5;
}

/* —— 区块 —— */
.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: 0.04em;
}

.section-link {
  font-size: var(--font-size-sm);
  color: var(--color-brand);
}

.panel {
  padding: 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.panel.soft {
  padding: 24rpx 28rpx;
}

.panel.empty {
  border-style: dashed;
  align-items: center;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.panel.state {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: flex-start;
}

.btn-inline {
  width: auto !important;
  padding: 0 40rpx;
  margin: 0;
}

.muted {
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.danger {
  color: var(--color-danger);
  font-size: var(--font-size-md);
}

.tiny {
  font-size: 22rpx;
}

.hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.55;
}

/* —— 公告轮播 —— */
.announce-swiper-wrap {
  border-radius: var(--radius-md);
  overflow: hidden;
}

.announce-swiper {
  height: 236rpx;
}

.announce-swiper .announce-card {
  height: 100%;
  box-sizing: border-box;
}

.announce-card {
  display: flex;
  flex-direction: row;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  overflow: hidden;
}

.announce-card.pinned {
  border-color: var(--color-border-strong);
  background: var(--color-surface);
}

.announce-accent {
  width: 6rpx;
  flex-shrink: 0;
  background: var(--color-border);
}

.announce-card.pinned .announce-accent {
  background: var(--color-brand);
}

.announce-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  justify-content: center;
}

.announce-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.announce-title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.announce-date {
  flex-shrink: 0;
  margin-left: auto;
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.2;
}

.pin {
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1;
  color: var(--color-brand);
  border: 1rpx solid var(--color-brand);
  border-radius: var(--radius-sm);
  padding: 4rpx 10rpx;
}

.announce-content {
  flex: 1;
  min-height: 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* —— 今日活动 —— */
.event-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.event-row {
  display: flex;
  flex-direction: row;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  overflow: hidden;
}

.event-row:active {
  background: var(--color-brand-muted);
}

.event-bar {
  width: 8rpx;
  flex-shrink: 0;
  background: var(--color-border-strong);
}

.event-bar.urgency-hot {
  background: var(--color-urgency-hot);
}

.event-bar.urgency-soon {
  background: var(--color-urgency-soon);
}

.event-bar.urgency-calm {
  background: var(--color-urgency-calm);
}

.event-main {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.event-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.event-name {
  font-size: var(--font-size-md);
  color: var(--color-text);
  font-weight: 500;
}

.event-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.event-time {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.event-phase {
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  color: var(--color-text-muted);
  background: var(--color-bg);
}

.event-phase.phase-upcoming {
  color: var(--color-text-secondary);
}

.event-phase.phase-live {
  color: var(--color-success);
  border-color: var(--color-success);
  background: var(--color-bg);
}

.event-phase.phase-ended {
  color: var(--color-text-muted);
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-strong);
  color: var(--color-brand);
  background: var(--color-brand-muted);
}

