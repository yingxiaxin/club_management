@import "../../styles/urgency.wxss";

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 90% 45% at 50% -8%, var(--color-bg-glow), transparent 70%),
    var(--color-bg);
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* —— 品牌门厅 —— */
.hero {
  position: relative;
  padding: 12rpx 0 8rpx;
}

.hero-glow {
  position: absolute;
  left: 10%;
  right: 10%;
  top: 20%;
  height: 120rpx;
  background: radial-gradient(ellipse at center, var(--color-brand-glow), transparent 72%);
  opacity: 0.45;
  pointer-events: none;
}

.hero-frame {
  position: relative;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-strong);
  background:
    linear-gradient(165deg, rgba(201, 162, 39, 0.08), transparent 42%),
    var(--color-surface);
  box-shadow: 0 0 40rpx rgba(201, 162, 39, 0.08);
  overflow: hidden;
}

.hero-frame::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: linear-gradient(180deg, var(--color-brand-hover), var(--color-brand), transparent);
}

.hero-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
  padding: 36rpx 32rpx;
}

.club-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border-strong);
  background: var(--color-surface-elevated);
  flex-shrink: 0;
  box-shadow: 0 0 24rpx rgba(201, 162, 39, 0.18);
}

.club-icon.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-mark {
  font-size: 44rpx;
  color: var(--color-brand);
  font-weight: 700;
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.brand {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--color-brand);
  line-height: 1.25;
}

.intro {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
}

/* —— 个人信息（俱乐部栏下方） —— */
.me-card {
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface-glass);
  overflow: hidden;
  box-shadow: inset 0 1rpx 0 rgba(201, 162, 39, 0.06);
}

.me-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 24rpx;
}

.me-head.tappable:active {
  background: var(--color-brand-muted);
}

.me-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.me-label {
  font-size: 20rpx;
  color: var(--color-text-muted);
  letter-spacing: 0.06em;
}

.identity-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.identity-dot.ok {
  background: var(--color-success);
  box-shadow: 0 0 10rpx var(--color-success);
}

.identity-dot.wait {
  background: var(--color-warning);
  box-shadow: 0 0 10rpx var(--color-warning);
}

.identity-main {
  font-size: var(--font-size-sm);
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-role {
  font-size: 22rpx;
  color: var(--color-brand);
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  padding: 2rpx 12rpx;
  background: var(--color-brand-muted);
  flex-shrink: 0;
}

.me-chevron {
  font-size: 36rpx;
  line-height: 1;
  color: var(--color-brand);
  opacity: 0.7;
  transform: rotate(90deg);
  transition: transform 0.2s ease;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.me-chevron.open {
  transform: rotate(-90deg);
  opacity: 1;
}

.me-tools {
  border-top: 1rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  background:
    linear-gradient(180deg, rgba(201, 162, 39, 0.05), transparent 48%),
    var(--color-surface);
}

.me-tool {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.me-tool:last-child {
  border-bottom: none;
}

.me-tool:active {
  background: var(--color-brand-muted);
}

.me-tool-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.me-tool-title {
  font-size: var(--font-size-sm);
  color: var(--color-text);
  font-weight: 500;
}

.me-tool-desc {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.me-tool-arrow {
  font-size: 32rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

/* —— 快捷入口 —— */
.shortcuts {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.shortcut {
  flex: 1;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-strong);
  background:
    linear-gradient(180deg, rgba(201, 162, 39, 0.1), transparent 55%),
    var(--color-surface);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.shortcut:active {
  background: var(--color-brand-muted);
}

.shortcut-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text);
}

.shortcut-desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.guest-cta {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.guest-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: 0.04em;
}

.steps {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 4rpx 0 8rpx;
}

.step {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary, var(--color-text-muted));
  line-height: 1.5;
}

/* —— 区块 —— */
.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: 0.04em;
}

.section-link {
  font-size: var(--font-size-sm);
  color: var(--color-brand);
}

.panel {
  padding: 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.panel.soft {
  padding: 24rpx 28rpx;
}

.panel.empty {
  border-style: dashed;
  align-items: center;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.panel.state {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: flex-start;
}

.btn-inline {
  width: auto !important;
  padding: 0 40rpx;
  margin: 0;
}

.muted {
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.danger {
  color: var(--color-danger);
  font-size: var(--font-size-md);
}

.tiny {
  font-size: 22rpx;
}

.hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.55;
}

/* —— 公告 —— */
.announce-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.announce-card {
  display: flex;
  flex-direction: row;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  overflow: hidden;
}

.announce-card.pinned {
  border-color: var(--color-border-strong);
  background:
    linear-gradient(90deg, rgba(201, 162, 39, 0.07), transparent 40%),
    var(--color-surface);
}

.announce-accent {
  width: 6rpx;
  flex-shrink: 0;
  background: var(--color-border);
}

.announce-card.pinned .announce-accent {
  background: linear-gradient(180deg, var(--color-brand-hover), var(--color-brand));
}

.announce-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.announce-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.announce-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text);
}

.pin {
  font-size: 20rpx;
  color: var(--color-brand);
  border: 1rpx solid var(--color-brand);
  border-radius: var(--radius-sm);
  padding: 2rpx 10rpx;
}

.announce-content {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.55;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.announce-card.open .announce-content {
  -webkit-line-clamp: unset;
  display: block;
  color: var(--color-text);
}

.announce-hint {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* —— 今日活动 —— */
.event-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.event-row {
  display: flex;
  flex-direction: row;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  overflow: hidden;
}

.event-row:active {
  background: var(--color-brand-muted);
}

.event-bar {
  width: 8rpx;
  flex-shrink: 0;
  background: var(--color-border-strong);
}

.event-bar.urgency-hot {
  background: var(--color-urgency-hot);
}

.event-bar.urgency-soon {
  background: var(--color-urgency-soon);
}

.event-bar.urgency-calm {
  background: var(--color-urgency-calm);
}

.event-main {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.event-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.event-name {
  font-size: var(--font-size-md);
  color: var(--color-text);
  font-weight: 500;
}

.event-time {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-strong);
  color: var(--color-brand);
  background: var(--color-brand-muted);
}

