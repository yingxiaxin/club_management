@import "../../styles/shell.wxss";

.page {
  padding: 40rpx 32rpx 64rpx;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 36rpx 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-strong);
  background:
    linear-gradient(165deg, rgba(189, 163, 119, 0.1), transparent 45%),
    var(--color-surface);
  box-shadow: 0 0 32rpx rgba(189, 163, 119, 0.06);
}

.title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-brand);
  letter-spacing: 0.04em;
}

.meta,
.label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.input {
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface-elevated);
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: var(--font-size-md);
}

.msg {
  font-size: var(--font-size-sm);
  color: var(--color-brand);
  line-height: 1.5;
}

.steps {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 0 4rpx;
}

.step {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  line-height: 1.5;
}

.admin-tip {
  color: var(--color-brand);
}

.icon-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding-top: 8rpx;
}

.icon-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 88rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface-elevated);
  box-sizing: border-box;
}

.icon-action-hover {
  background: var(--color-brand-muted);
  border-color: var(--color-border-strong);
}

.icon-action.disabled {
  opacity: 0.55;
  pointer-events: none;
}

.icon-action-img {
  width: 44rpx;
  height: 44rpx;
}

.icon-action-mark {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 44rpx;
  text-align: center;
  color: var(--color-text-muted);
}

.icon-action-label {
  font-size: 20rpx;
  color: var(--color-text-muted);
  line-height: 1.2;
}

.tiny {
  font-size: 22rpx;
}
