<view class="page">
  <view class="panel" wx:if="{{loading}}">
    <text class="muted">加载中…</text>
  </view>

  <block wx:elif="{{alreadyBound}}">
    <view class="panel">
      <text class="title">你已关联成员</text>
      <text class="meta" wx:if="{{boundName}}">当前：{{boundName}}</text>
      <text class="meta">可直接查看俱乐部成员列表。</text>
      <button class="btn-primary" bindtap="goMembers">查看成员列表</button>
      <button
        wx:if="{{isAdmin}}"
        class="btn-ghost"
        loading="{{unbinding}}"
        bindtap="onUnbindForTest"
      >
        解除关联（联调）
      </button>
      <text class="muted" wx:if="{{isAdmin}}">仅管理员可见：解除后可再测邀请码关联。</text>
      <text class="msg" wx:if="{{message}}">{{message}}</text>
    </view>
  </block>

  <block wx:elif="{{application && application.status === 'pending'}}">
    <view class="panel">
      <text class="title">关联申请审核中</text>
      <text class="meta">角色名：{{application.characterName}}</text>
      <text class="muted">请等待管理员确认后，即可查看成员列表。</text>
      <button class="btn-ghost" bindtap="refresh">刷新状态</button>
    </view>
  </block>

  <block wx:else>
    <view class="panel" wx:if="{{application && application.status === 'rejected'}}">
      <text class="title">上次关联未通过</text>
      <text class="meta">角色名：{{application.characterName}}</text>
      <text class="muted">可核对角色名后重新提交。</text>
    </view>
    <view class="panel form">
      <text class="title">邀请码关联</text>
      <text class="meta">
        用邀请码把你的微信与俱乐部名单中的角色关联。角色名须与名单完全一致；不在名单中无法关联。
      </text>
      <text class="meta" wx:if="{{isAdmin}}">（当前为管理员微信，仅联调测试用）</text>
      <view class="field">
        <text class="label">邀请码</text>
        <input class="input" value="{{inviteCode}}" bindinput="onInviteInput" placeholder="管理员提供的邀请码" />
      </view>
      <view class="field">
        <text class="label">角色名</text>
        <input class="input" value="{{characterName}}" bindinput="onNameInput" placeholder="须与俱乐部名单一致" maxlength="32" />
      </view>
      <view class="field">
        <text class="label">留言（可选）</text>
        <input class="input" value="{{remark}}" bindinput="onRemarkInput" placeholder="给管理员的说明" />
      </view>
      <button
        class="btn-primary"
        loading="{{submitting}}"
        disabled="{{submitting || !inviteCode || !characterName}}"
        bindtap="onSubmit"
      >提交关联申请</button>
      <text class="msg" wx:if="{{message}}">{{message}}</text>
    </view>
  </block>
</view>
