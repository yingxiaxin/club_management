<view class="page">
  <view class="panel" wx:if="{{loading}}">
    <text class="muted">加载中…</text>
  </view>

  <block wx:elif="{{alreadyBound}}">
    <view class="panel">
      <text class="title">你已关联角色</text>
      <text class="meta" wx:if="{{boundName}}">当前角色：{{boundName}}</text>
      <text class="meta">可以查看公告、活动日程与成员列表了。</text>
      <view class="icon-actions">
        <view class="icon-action" bindtap="goHome" hover-class="icon-action-hover" hover-stay-time="80">
          <image class="icon-action-img" src="/assets/tab/home-active.png" mode="aspectFit" />
          <text class="icon-action-label">首页</text>
        </view>
        <view
          wx:if="{{isAdmin}}"
          class="icon-action {{unbinding ? 'disabled' : ''}}"
          bindtap="onUnbindForTest"
          hover-class="icon-action-hover"
          hover-stay-time="80"
        >
          <text class="icon-action-mark">⊘</text>
          <text class="icon-action-label">解绑</text>
        </view>
      </view>
      <text class="muted tiny" wx:if="{{isAdmin}}">解绑后可用邀请码重新关联。</text>
      <text class="msg" wx:if="{{message}}">{{message}}</text>
    </view>
  </block>

  <block wx:elif="{{application && application.status === 'pending'}}">
    <view class="panel">
      <text class="title">关联申请审核中</text>
      <text class="meta">角色名：{{application.characterName}}</text>
      <text class="meta">已提交给管理员。通过后即可查看俱乐部信息，无需重复提交。</text>
      <button class="btn-primary" bindtap="refresh">刷新状态</button>
      <button class="btn-ghost" bindtap="goHome">回首页</button>
    </view>
  </block>

  <block wx:else>
    <view class="panel" wx:if="{{application && application.status === 'rejected'}}">
      <text class="title">上次关联未通过</text>
      <text class="meta">角色名：{{application.characterName}}</text>
      <text class="muted">请核对角色名是否与俱乐部名单完全一致后重新提交；也可联系管理员确认名单。</text>
    </view>
    <view class="panel form">
      <text class="title">邀请码关联角色</text>
      <text class="meta">把微信与俱乐部名单中的角色关联。名单由管理员维护，邀请码不会新建角色。</text>
      <view class="steps">
        <text class="step">1. 向管理员索取有效邀请码</text>
        <text class="step">2. 角色名须与名单完全一致（含标点与空格）</text>
        <text class="step">3. 提交后等待管理员确认</text>
      </view>
      <text class="meta admin-tip" wx:if="{{isAdmin}}">当前为管理员微信，可用于代测或协助成员关联。</text>
      <view class="field">
        <text class="label">邀请码</text>
        <input class="input" value="{{inviteCode}}" bindinput="onInviteInput" placeholder="管理员发给你的邀请码" />
      </view>
      <view class="field">
        <text class="label">角色名</text>
        <input class="input" value="{{characterName}}" bindinput="onNameInput" placeholder="与俱乐部名单完全一致" maxlength="32" />
      </view>
      <view class="field">
        <text class="label">留言（可选）</text>
        <input class="input" value="{{remark}}" bindinput="onRemarkInput" placeholder="方便管理员核对，如游戏区服" />
      </view>
      <button
        class="btn-primary"
        loading="{{submitting}}"
        disabled="{{submitting || !inviteCode || !characterName}}"
        bindtap="onSubmit"
      >提交关联申请</button>
      <text class="msg" wx:if="{{message}}">{{message}}</text>
    </view>
  </block>
</view>

<home-fab />
