@import "../../styles/shell.wxss";
@import "../../styles/urgency.wxss";

.page {
  padding-bottom: 32rpx;
}

.row-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.name {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text);
}

.time {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.status {
  font-size: 22rpx;
  color: var(--color-success);
}

.rsvp-brief {
  font-size: 22rpx;
  color: var(--color-text-muted);
}
