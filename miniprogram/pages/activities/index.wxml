<view class="page">
  <view class="page-state" wx:if="{{loading}}">
    <text class="muted">加载中…</text>
  </view>
  <view class="page-state" wx:elif="{{error}}">
    <text class="danger">{{error}}</text>
    <button class="btn-primary retry" size="mini" bindtap="load">重试</button>
  </view>

  <block wx:else>
    <view class="section">
      <view class="section-head">
        <text class="section-title">今日活动</text>
        <text class="section-meta" wx:if="{{todayLabel}}">{{todayLabel}}</text>
      </view>
      <view class="empty-panel" wx:if="{{!today.length}}">
        <text class="muted">今日暂无已发布活动</text>
        <text class="muted tiny">管理员发布后会出现在这里</text>
      </view>
      <view class="list-stack" wx:else>
        <view
          class="bar-row"
          wx:for="{{today}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goDetail"
        >
          <view class="bar {{item.urgencyClass}}" />
          <view class="bar-main">
            <view class="row-top">
              <text class="name {{item.urgencyClass}}">{{item.title}}</text>
              <text class="chip-tag {{item.urgencyClass}}">
                <text wx:if="{{item.urgencyIcon}}" class="tag-icon">{{item.urgencyIcon}}</text>{{item.typeLabel}}
              </text>
            </view>
            <text class="time">{{item.startText}}</text>
            <text class="rsvp-brief" wx:if="{{item.rsvpCounts.total}}">
              参加 {{item.rsvpCounts.going}} · 待定 {{item.rsvpCounts.maybe}} · 请假 {{item.rsvpCounts.decline}}
            </text>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">本周活动</text>
        <text class="section-meta" wx:if="{{weekRange}}">{{weekRange}}</text>
      </view>
      <view class="empty-panel" wx:if="{{!week.length}}">
        <text class="muted">本周暂无已发布活动</text>
        <text class="muted tiny">可先看看今日，或稍后再来</text>
      </view>
      <view class="list-stack" wx:else>
        <view
          class="bar-row"
          wx:for="{{week}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goDetail"
        >
          <view class="bar {{item.urgencyClass}}" />
          <view class="bar-main">
            <view class="row-top">
              <text class="name {{item.urgencyClass}}">{{item.title}}</text>
              <text class="chip-tag {{item.urgencyClass}}">
                <text wx:if="{{item.urgencyIcon}}" class="tag-icon">{{item.urgencyIcon}}</text>{{item.typeLabel}}
              </text>
            </view>
            <text class="time">{{item.startText}}</text>
            <text class="rsvp-brief" wx:if="{{item.rsvpCounts.total}}">
              参加 {{item.rsvpCounts.going}} · 待定 {{item.rsvpCounts.maybe}} · 请假 {{item.rsvpCounts.decline}}
            </text>
            <text class="status" wx:if="{{item.status === 'ongoing'}}">{{item.statusLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
