@import "../../styles/shell.wxss";

.page {
  padding: 40rpx 32rpx 64rpx;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 36rpx 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-strong);
  background:
    linear-gradient(165deg, rgba(189, 163, 119, 0.1), transparent 45%),
    var(--color-surface);
  box-shadow: 0 0 32rpx rgba(189, 163, 119, 0.06);
}

.title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-brand);
  letter-spacing: 0.04em;
}

.meta,
.label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.input {
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface-elevated);
  border: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: var(--font-size-md);
}

.msg {
  font-size: var(--font-size-sm);
  color: var(--color-brand);
  line-height: 1.5;
}
