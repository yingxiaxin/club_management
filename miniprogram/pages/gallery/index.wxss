@import "../../styles/shell.wxss";
@import "../../styles/pathway.wxss";
@import "../../styles/photo-stack.wxss";

.toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 4rpx;
}

.toolbar-hint {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.btn-publish {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
}

.sort-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  padding: 4rpx 4rpx 0;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  background: var(--color-bg);
  box-sizing: border-box;
}

.chip.active {
  color: var(--color-brand);
  border-color: var(--color-border-strong);
  background: var(--color-brand-muted);
}

.empty-panel {
  padding: 80rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border-radius: var(--radius-md);
  border: 1rpx dashed var(--color-border);
  background: var(--color-surface);
}

.tiny {
  font-size: 22rpx;
}

.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 20rpx 16rpx;
  padding: 8rpx 4rpx 12rpx;
}

.cell {
  width: calc((100% - 16rpx) / 2);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  overflow: hidden;
  box-sizing: border-box;
}

.cell:active {
  background: var(--color-brand-muted);
}

.cell-meta {
  padding: 10rpx 12rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cell-name {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.cell-cap {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-likes {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--color-brand);
}
