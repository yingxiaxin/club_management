/**
 * 诡秘风 Design Tokens —— 与 admin / 视觉风格指南对齐
 * 换肤只改本文件；业务页只用 var(--*)。
 * 小程序把变量挂在 page 上（无 :root）。
 */
page {
  /* Brand — antique gold */
  --color-brand: #c9a227;
  --color-brand-hover: #e0bc4a;
  --color-brand-muted: rgba(201, 162, 39, 0.16);
  --color-brand-glow: rgba(201, 162, 39, 0.35);

  /* Surface — deep charcoal */
  --color-bg: #0e0f14;
  --color-bg-glow: #2a2218;
  --color-surface: #1a1c22;
  --color-surface-elevated: #22252e;
  --color-surface-glass: rgba(26, 28, 34, 0.92);
  --color-border: #3a3428;
  --color-border-strong: #6b5a32;

  /* Text — warm cream */
  --color-text: #f5ecdc;
  --color-text-secondary: #d4c4a8;
  --color-text-muted: #a09078;
  --color-text-inverse: #1a140a;

  /* Status */
  --color-success: #7aab76;
  --color-warning: #d4a04a;
  --color-danger: #b86558;
  --color-info: #7d9ab0;

  /* 活动紧迫度：类型 label（在品牌金/状态色基础上偏红/黄/绿） */
  --color-urgency-hot: #d4785a;
  --color-urgency-hot-muted: rgba(212, 120, 90, 0.18);
  --color-urgency-hot-border: #8a4a3a;
  --color-urgency-soon: #d4a04a;
  --color-urgency-soon-muted: rgba(212, 160, 74, 0.18);
  --color-urgency-soon-border: #8a6a32;
  --color-urgency-calm: #7aab76;
  --color-urgency-calm-muted: rgba(122, 171, 118, 0.16);
  --color-urgency-calm-border: #4a6a48;

  /* 标题字：奶油白微偏橙红 / 琥珀 / 苔绿 */
  --color-text-urgency-hot: #f0c4b0;
  --color-text-urgency-soon: #efe0b0;
  --color-text-urgency-calm: #d4e0c8;

  /* Layout */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --font-size-sm: 26rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 34rpx;
  --font-size-xl: 40rpx;
}
