/**
 * 诡秘风 Design Tokens —— 与 admin / 视觉风格指南对齐
 * 换肤只改本文件；业务页只用 var(--*)。
 * 小程序把变量挂在 page 上（无 :root）。
 */
page {
  /* Brand — olive bronze（再提两档） */
  --color-brand: #bda377;
  --color-brand-hover: #d9c18f;
  --color-brand-muted: rgba(189, 163, 119, 0.22);
  --color-brand-glow: rgba(189, 163, 119, 0.4);

  /* Surface — deep charcoal（微暖） */
  --color-bg: #0e0f14;
  --color-bg-glow: #221c14;
  --color-surface: #1a1c22;
  --color-surface-elevated: #22252e;
  --color-surface-glass: rgba(26, 28, 34, 0.92);
  --color-border: #3a3428;
  --color-border-strong: #cbb383;

  /* Text — 奶油白微偏暖橄榄 */
  --color-text: #f3ecdf;
  --color-text-secondary: #d0c4a8;
  --color-text-muted: #9a8c78;
  --color-text-inverse: #1a140a;

  /* Status */
  --color-success: #7aab76;
  --color-warning: #d4894a;
  --color-danger: #b86558;
  --color-info: #7d9ab0;

  /* 途径色 — 用户自职业色彩2提取（窥秘为提亮后实色） */
  --color-pathway-audience: #94c7b1;
  --color-pathway-warrior: #d3742e;
  --color-pathway-bard: #debd39;
  --color-pathway-apprentice: #2c81b0;
  --color-pathway-diviner: #54599f;
  --color-pathway-pryer: #975dc1;
  /* 与管理端色签/行渐变弱底对齐 */
  --color-pathway-audience-muted: rgba(148, 199, 177, 0.16);
  --color-pathway-warrior-muted: rgba(211, 116, 46, 0.16);
  --color-pathway-bard-muted: rgba(222, 189, 57, 0.16);
  --color-pathway-apprentice-muted: rgba(44, 129, 176, 0.16);
  --color-pathway-diviner-muted: rgba(84, 89, 159, 0.18);
  --color-pathway-pryer-muted: rgba(151, 93, 193, 0.16);

  /* 活动紧迫度：偏红 / 橙褐（避开歌颂黄） / 苔绿 */
  --color-urgency-hot: #d4785a;
  --color-urgency-hot-muted: rgba(212, 120, 90, 0.18);
  --color-urgency-hot-border: #8a4a3a;
  --color-urgency-soon: #d4894a;
  --color-urgency-soon-muted: rgba(212, 137, 74, 0.18);
  --color-urgency-soon-border: #8a5a32;
  --color-urgency-calm: #7aab76;
  --color-urgency-calm-muted: rgba(122, 171, 118, 0.16);
  --color-urgency-calm-border: #4a6a48;

  /* 标题字：奶油白微偏橙红 / 琥珀 / 苔绿 */
  --color-text-urgency-hot: #f0c4b0;
  --color-text-urgency-soon: #efe0b0;
  --color-text-urgency-calm: #d4e0c8;

  /* Layout */
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --font-size-sm: 26rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 34rpx;
  --font-size-xl: 40rpx;
}
