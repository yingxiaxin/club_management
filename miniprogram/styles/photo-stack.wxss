/**
 * 踏云寻芳预览：照片叠放（最上层为真图；底层仅向右轻幅错开）
 */
.photo-stack {
  position: relative;
  width: 100%;
  height: 280rpx;
  box-sizing: border-box;
  padding: 10rpx 16rpx 16rpx 10rpx;
}

.photo-stack.compact {
  height: 200rpx;
  padding: 8rpx 14rpx 12rpx 8rpx;
}

.photo-stack-layer {
  position: absolute;
  left: 10rpx;
  right: 16rpx;
  top: 10rpx;
  bottom: 16rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-strong);
  background: var(--color-surface-elevated);
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.28);
  transform-origin: left center;
}

.photo-stack.compact .photo-stack-layer {
  left: 8rpx;
  right: 14rpx;
  top: 8rpx;
  bottom: 12rpx;
}

/* 底层只向右侧轻幅错开 */
.photo-stack-layer.back2 {
  transform: rotate(3.5deg) translate(5rpx, 2rpx);
  opacity: 0.5;
  background: var(--color-brand-muted);
}

.photo-stack-layer.back1 {
  transform: rotate(1.8deg) translate(3rpx, 1rpx);
  opacity: 0.72;
}

.photo-stack-front {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  display: block;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-strong);
  background: var(--color-surface-elevated);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}
