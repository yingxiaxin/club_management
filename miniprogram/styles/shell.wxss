/**
 * 内页共用壳：与首页会所门厅气质对齐（色值只来自 tokens）
 */
.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(ellipse 90% 42% at 50% -8%, var(--color-bg-glow), transparent 70%),
    var(--color-bg);
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.page-state {
  padding: 80rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.muted {
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.danger {
  color: var(--color-danger);
  font-size: var(--font-size-md);
  text-align: center;
}

.retry {
  width: auto !important;
  padding: 0 32rpx;
  margin: 0;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: 0.04em;
}

.section-meta {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
}

.empty-panel {
  padding: 40rpx 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx dashed var(--color-border);
  background: var(--color-surface);
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
}

.panel-card {
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  overflow: hidden;
}

.panel-card.framed {
  border-color: var(--color-border-strong);
  background:
    linear-gradient(165deg, rgba(135, 116, 80, 0.08), transparent 42%),
    var(--color-surface);
  box-shadow: 0 0 32rpx rgba(135, 116, 80, 0.06);
}

.list-stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 左侧色条列表行（活动等） */
.bar-row {
  display: flex;
  flex-direction: row;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  background: var(--color-surface);
  overflow: hidden;
}

.bar-row:active {
  background: var(--color-brand-muted);
  border-color: var(--color-border-strong);
}

.bar-row .bar {
  width: 8rpx;
  flex-shrink: 0;
  background: var(--color-border-strong);
}

.bar-row .bar.urgency-hot {
  background: var(--color-urgency-hot);
}

.bar-row .bar.urgency-soon {
  background: var(--color-urgency-soon);
}

.bar-row .bar.urgency-calm {
  background: var(--color-urgency-calm);
}

.bar-row .bar.accent {
  background: linear-gradient(180deg, var(--color-brand-hover), var(--color-brand));
}

.bar-row .bar-main {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.chip-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border-strong);
  color: var(--color-brand);
  background: var(--color-brand-muted);
}

.tiny {
  font-size: 22rpx;
}
